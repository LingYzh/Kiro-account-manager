{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": [
        "src/renderer-vue/src/**/*.ts",
        "src/renderer-vue/src/**/*.vue",
        "src/renderer-vue/src/**/*.js",
        "src/renderer-shared/**/*.ts",
        "src/preload/*.d.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "allowJs": true,
        "checkJs": false,
        "jsx": "preserve",
        "types": [
            "vite/client"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/renderer-vue/src/*"
            ],
            "@renderer/*": [
                "src/renderer-vue/src/*"
            ],
            "@shared/*": [
                "src/renderer-shared/*"
            ]
        }
    }
}
